<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Staffing Module — Mobile UI Mockup</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#0f172a; --navy-soft:#1e293b;
    --ink:#0f172a; --body:#334155; --muted:#64748b; --faint:#94a3b8;
    --paper:#f4f6f9; --card:#ffffff; --line:#e6e9f0; --line-soft:#eef1f6;
    --accent:#4f46e5; --accent-dark:#4338ca; --accent-soft:#eef0fe;
    --success:#0f9d6a; --success-soft:#e5f8f1;
    --warn:#b45309; --warn-soft:#fef3e0;
    --danger:#dc2626; --danger-soft:#fdeceb;
    --info:#0369a1; --info-soft:#e6f4fb;
  }
  * { box-sizing:border-box; margin:0; padding:0; }
  body{
    font-family:'Inter',Arial,sans-serif; background:#e8eaf0; color:var(--body);
    display:flex; flex-wrap:wrap; gap:36px; justify-content:center; padding:40px 20px;
    font-size:14px;
  }
  .frame-block{ display:flex; flex-direction:column; align-items:center; gap:12px; }
  .frame-label{ font-size:12px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.05em; }
  .phone{
    width:340px; height:700px; background:var(--paper); border-radius:36px; overflow:hidden;
    box-shadow:0 0 0 8px #1a1a1a, 0 0 0 10px #333, 0 20px 50px rgba(0,0,0,.25);
    position:relative; display:flex; flex-direction:column;
  }
  .notch{ position:absolute; top:0; left:50%; transform:translateX(-50%); width:130px; height:22px; background:#1a1a1a; border-radius:0 0 14px 14px; z-index:20; }
  .statusbar{ height:38px; display:flex; align-items:flex-end; justify-content:space-between; padding:0 20px 4px; font-size:12px; font-weight:700; color:#fff; background:var(--navy); flex-shrink:0; }

  .appbar{ background:var(--navy); color:#fff; padding:14px 18px 18px; flex-shrink:0; }
  .appbar-top{ display:flex; align-items:center; justify-content:space-between; margin-bottom:2px; }
  .appbar-title{ font-size:18px; font-weight:800; }
  .appbar-sub{ font-size:11.5px; color:#94a3b8; margin-top:2px; }
  .icon-btn{ width:32px; height:32px; border-radius:9px; background:rgba(255,255,255,.1); display:flex; align-items:center; justify-content:center; font-size:15px; color:#fff; }

  .scroll{ flex:1; overflow-y:auto; padding:16px; }
  .scroll::-webkit-scrollbar{ display:none; }

  .kpi-grid{ display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:16px; }
  .kpi{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; }
  .kpi .n{ font-size:20px; font-weight:800; color:var(--ink); }
  .kpi .l{ font-size:10.5px; color:var(--muted); text-transform:uppercase; letter-spacing:.03em; font-weight:700; margin-top:3px; }
  .kpi .d{ font-size:10.5px; font-weight:700; margin-top:5px; }
  .kpi .d.up{ color:var(--success); }
  .kpi .d.warn{ color:var(--warn); }

  .section-title{ font-size:13px; font-weight:800; color:var(--ink); margin:18px 0 10px; display:flex; align-items:center; justify-content:space-between; }
  .section-title a{ font-size:11.5px; font-weight:700; color:var(--accent); text-decoration:none; }

  .card{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; margin-bottom:10px; }
  .row-between{ display:flex; align-items:center; justify-content:space-between; }

  .avatar{ width:38px; height:38px; border-radius:11px; background:var(--accent-soft); color:var(--accent); display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:800; flex-shrink:0; }
  .list-item{ display:flex; align-items:center; gap:11px; padding:10px 0; border-bottom:1px solid var(--line-soft); }
  .list-item:last-child{ border-bottom:none; }
  .li-title{ font-size:13px; font-weight:700; color:var(--ink); }
  .li-sub{ font-size:11.5px; color:var(--muted); margin-top:1px; }

  .badge{ font-size:10px; font-weight:800; padding:3px 9px; border-radius:20px; text-transform:uppercase; letter-spacing:.02em; white-space:nowrap; }
  .badge-success{ background:var(--success-soft); color:var(--success); }
  .badge-warn{ background:var(--warn-soft); color:var(--warn); }
  .badge-danger{ background:var(--danger-soft); color:var(--danger); }
  .badge-info{ background:var(--info-soft); color:var(--info); }
  .badge-neutral{ background:#eef0f4; color:var(--muted); }

  .fab{ position:absolute; right:16px; bottom:78px; width:52px; height:52px; border-radius:16px; background:var(--accent); color:#fff; display:flex; align-items:center; justify-content:center; font-size:22px; font-weight:400; box-shadow:0 10px 20px rgba(79,70,229,.35); z-index:10; }

  .bottomnav{ height:64px; background:#fff; border-top:1px solid var(--line); display:flex; flex-shrink:0; }
  .bn-item{ flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; color:var(--faint); font-size:9.5px; font-weight:700; }
  .bn-item .ic{ font-size:17px; }
  .bn-item.active{ color:var(--accent); }

  .search-bar{ display:flex; align-items:center; gap:8px; background:#fff; border:1px solid var(--line); border-radius:11px; padding:10px 12px; margin-bottom:10px; }
  .search-bar input{ border:none; outline:none; font-family:inherit; font-size:12.5px; flex:1; color:var(--ink); }
  .chip-row{ display:flex; gap:7px; overflow-x:auto; margin-bottom:14px; padding-bottom:2px; }
  .chip{ padding:7px 13px; border-radius:20px; background:#fff; border:1px solid var(--line); font-size:11.5px; font-weight:700; color:var(--body); white-space:nowrap; }
  .chip.active{ background:var(--navy); color:#fff; border-color:var(--navy); }

  .field{ margin-bottom:14px; }
  .field label{ display:block; font-size:11.5px; font-weight:700; color:var(--body); margin-bottom:6px; }
  .field input, .field select{ width:100%; padding:11px 12px; border:1px solid var(--line); border-radius:10px; font-family:inherit; font-size:13px; background:#fff; color:var(--ink); }

  .stepper{ display:flex; align-items:center; margin-bottom:18px; }
  .step{ display:flex; align-items:center; flex:1; }
  .step .dot{ width:24px; height:24px; border-radius:50%; background:#eef0f4; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:10.5px; font-weight:800; flex-shrink:0; }
  .step.done .dot{ background:var(--success); color:#fff; }
  .step.active .dot{ background:var(--accent); color:#fff; }
  .step .bar{ flex:1; height:2px; background:var(--line); margin:0 4px; }
  .step.done .bar{ background:var(--success); }

  .btn-primary{ display:block; width:100%; background:var(--accent); color:#fff; border:none; padding:13px; border-radius:11px; font-family:inherit; font-size:13px; font-weight:700; text-align:center; }
  .btn-outline{ display:block; width:100%; background:#fff; color:var(--body); border:1px solid var(--line); padding:13px; border-radius:11px; font-family:inherit; font-size:13px; font-weight:700; text-align:center; margin-top:8px; }

  .progress-track{ height:6px; background:#eef0f4; border-radius:4px; overflow:hidden; margin-top:8px; }
  .progress-fill{ height:100%; background:var(--accent); border-radius:4px; }

  .sync-hero{ background:var(--navy); border-radius:16px; padding:20px; color:#fff; margin-bottom:16px; }
  .sync-hero .big{ font-size:26px; font-weight:800; margin:8px 0 2px; }
  .sync-hero .lbl{ font-size:11px; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; font-weight:700; }

  .checklist-item{ display:flex; align-items:center; gap:10px; padding:9px 0; border-bottom:1px solid var(--line-soft); }
  .checklist-item:last-child{ border-bottom:none; }
  .check-circle{ width:20px; height:20px; border-radius:50%; border:2px solid var(--line); flex-shrink:0; display:flex; align-items:center; justify-content:center; font-size:10px; }
  .check-circle.done{ background:var(--success); border-color:var(--success); color:#fff; }

  .kanban-col{ min-width:170px; background:#fff; border:1px solid var(--line); border-radius:14px; padding:12px; margin-right:10px; }
  .kanban-row{ display:flex; overflow-x:auto; margin:0 -16px; padding:0 16px 4px; }
  .kanban-title{ font-size:11px; font-weight:800; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); margin-bottom:10px; display:flex; justify-content:space-between; }
  .kanban-card{ background:var(--paper); border-radius:10px; padding:10px; margin-bottom:8px; font-size:11.5px; font-weight:700; color:var(--ink); }
  .kanban-card .s{ font-size:10.5px; color:var(--muted); font-weight:500; margin-top:3px; }

  .report-card{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:14px; margin-bottom:10px; display:flex; align-items:center; gap:12px; }
  .report-icon{ width:38px; height:38px; border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:16px; flex-shrink:0; }

  .drawer{ position:absolute; inset:0; background:rgba(15,23,42,.5); z-index:30; display:none; }
  .drawer.open{ display:block; }
  .drawer-panel{ position:absolute; top:0; left:0; bottom:0; width:270px; background:var(--navy); color:#fff; padding:20px 16px; overflow-y:auto; }
  .drawer-item{ display:flex; align-items:center; gap:12px; padding:11px 10px; border-radius:9px; color:#cbd5e1; font-size:13px; font-weight:600; margin-bottom:2px; }
  .drawer-item.active{ background:var(--navy-soft); color:#fff; }
  .drawer-header{ display:flex; align-items:center; gap:11px; padding-bottom:16px; margin-bottom:14px; border-bottom:1px solid #334155; }
  .drawer-avatar{ width:42px; height:42px; border-radius:12px; background:linear-gradient(135deg,var(--accent),#8b7cf6); display:flex; align-items:center; justify-content:center; font-weight:800; font-size:14px; }
  .drawer-group{ font-size:10px; color:#64748b; text-transform:uppercase; letter-spacing:.05em; font-weight:800; margin:14px 0 6px 10px; }
</style>
</head>
