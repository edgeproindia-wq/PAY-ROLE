# Set these as Environment Variables on Render (Dashboard -> Environment).
# NEVER commit real values to GitHub.

# Required in production (the app refuses to start without it when DEBUG is off)
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=payroll-ixgj.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://payroll-ixgj.onrender.com
# DJANGO_DEBUG defaults to false on Render (RENDER=true) and true locally.
# DJANGO_DEBUG=false

# Database (Aiven PostgreSQL). Omit locally to use db.sqlite3.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=require

# Email (Gmail example: use an App Password, not your normal password)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-sender@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=EdgePro Payroll <your-sender@gmail.com>
EMAIL_TIMEOUT=10

# Demo-request alerts
ADMIN_NOTIFICATION_EMAIL=admin@example.com
DEMO_NOTIFY_MOBILE=

# SMS: fast2sms or twilio (leave empty to disable - failures are only logged)
SMS_PROVIDER=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Uploaded receipts: point to a Render persistent disk, e.g. /var/data/media
MEDIA_ROOT=

# HTTPS (all default to on in production)
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true

# Private file storage (Cloudflare R2 / AWS S3)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=auto
